# ============================================================================
#  File        : .gitignore
#  Description : Build products, simulation output and tool working directories.
# ============================================================================

# ---- build products -------------------------------------------------------
build/
*.vvp
*.vcd
*.fsdb
*.vcd.gz
*.shm
*.key
*.log

# ---- LibreLane / OpenLane -------------------------------------------------
# The flow creates one working directory per run under librelane/runs; they are
# large, they are regenerated on demand, and a stale one is never useful.
librelane/runs/
# ...and it renames the previous one to runs_prev/ when a new run starts, so
# that a multi-gigabyte directory is one `git add -A` away from being committed.
# Both are ignored, and flow.log is ignored by the *.log rule above.
librelane/runs_prev/
out/

# The container's HOME, which is where the flow keeps its (multi-gigabyte) PDK
# download.  A local run points it here, inside the workspace, through the
# `-e HOME=` flag in librelane/README.md.  CI does not: it bind-mounts the PDK
# from the runner host's own ~/.cache/librelane, because `actions/checkout`
# runs `git clean -ffdx` and would delete this directory on the next run.
.cache/

# ---- Quartus (board/de2_115/quartus_ii) ------------------------------------
# The Quartus GUI and build.bat regenerate all of these; only the project
# source (.qpf/.qsf/.sdc/hdl/) is checked in.  *.log is covered by the rule
# above.
board/de2_115/quartus_ii/db/
board/de2_115/quartus_ii/incremental_db/
board/de2_115/quartus_ii/output_files/
board/de2_115/quartus_ii/greybox_tmp/
board/de2_115/quartus_ii/*.qws
board/de2_115/quartus_ii/*.jdi
board/de2_115/quartus_ii/*.rpt
board/de2_115/quartus_ii/*.smsg
board/de2_115/quartus_ii/*.summary
board/de2_115/quartus_ii/*.done
board/de2_115/quartus_ii/*.srf

# ---- editors / OS ---------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store

# Local AI assistant working directories
.workbuddy/
.zcode/

# ---- Vivado generated products (keep .xpr, HDL, Tcl and XDC sources) --------
board/vivado/.Xil/
board/vivado/vivado.cache/
board/vivado/vivado.gen/
board/vivado/vivado.hw/
board/vivado/vivado.ip_user_files/
board/vivado/vivado.runs/
board/vivado/vivado.sim/
board/vivado/*.jou
board/vivado/*.str
board/vivado/*.xpr.bak
board/vivado/*.xpr.zip

# Vivado batch sessions launched from the repository root
/.Xil/
